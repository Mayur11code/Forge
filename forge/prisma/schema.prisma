datasource db { 
  provider = "postgresql" 
  } 
generator client { 
  provider = "prisma-client-js" 
  }

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}


enum EventStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WorkflowExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  ROLLING_BACK
  ROLLED_BACK
  REQUIRES_INTERVENTION
}

enum StepExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
  RETRYING
  SKIPPED
  COMPENSATING
  COMPENSATED
  COMPENSATION_FAILED
}

enum LogLevel {
  INFO
  WARN
  ERROR
  FATAL
}

enum AgentSessionStatus {
  RUNNING
  WAITING_CONFIRMATION
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentToolExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED

  // Phase 2 confirmation state machine.
  //
  // PENDING_CONFIRMATION -> PENDING  (user confirmed; execution is now queued)
  // PENDING_CONFIRMATION -> CANCELLED (user declined; must never execute)
  // PENDING_CONFIRMATION -> EXPIRED   (approval window elapsed; must never execute)
  //
  // CANCELLED and EXPIRED are both terminal, and both are never resurrected and
  // never dispatched to the tool worker. They are deliberately distinct: a user
  // who actively declines is a different event from a user who simply never
  // answered, and collapsing them would misreport intent in the audit trail
  // and in the message the model is told to relay.
  PENDING_CONFIRMATION
  CANCELLED
  EXPIRED
}

// Assignment 37.8 (F4) — durable proposal lifecycle.
//
// The proposal's OWN state machine, deliberately separate from
// `AgentToolExecutionStatus`. `status` answers "did the tool run?"; this answers
// "where is the human decision about the proposal?". Conflating them would make
// "the execution completed" and "the proposal is awaiting a human" the same
// value, and there would be no honest state for "ran successfully, parked".
enum AgentProposalState {
  // The proposal compiled and passed every backend validation gate.
  VALIDATED
  // The worker returned NEEDS_USER_INPUT; the loop is parked on a human answer.
  NEEDS_CLARIFICATION
  // The human answered the clarification; the loop may re-enter to regenerate.
  CLARIFICATION_ACCEPTED
  // A valid proposal is parked until the human decides per-step criticality.
  AWAITING_CRITICALITY
  // Criticality was decided; the proposal is parked until approval (37.9).
  AWAITING_APPROVAL
  // The human approved the proposal. Written by 37.9.
  APPROVED
  // The human explicitly declined the proposal. Terminal: no `Workflow` is
  // materialized, no action runs, and the loop is not restarted. Written by 37.9.
  DECLINED
  // The approval window closed before the human decided. Terminal, and distinct
  // from DECLINED on purpose: an expiry is the SYSTEM giving up, never a user
  // refusing something they were never asked about. Written by 37.9.
  EXPIRED
  // A newer proposal for the same session replaced this one.
  SUPERSEDED
  // The model produced an invalid proposal (INVALID_INPUT); it self-corrects.
  INVALID
  // The proposal was turned into a `Workflow`. Written by 37.11.
  MATERIALIZED
}

enum AgentMessageRole {
    USER
    ASSISTANT
    TOOL
    SYSTEM
}

model AgentSession {
  id            String             @id @default(cuid())
  orgId         String
  userId        String

  status        AgentSessionStatus @default(RUNNING)
  currentStep   Int                @default(0)


  finalResponse String?            @db.Text
  errorMessage  String?            @db.Text

  // Machine-readable reason a session stopped. Free-text errorMessage is for
  // humans; this is for programmatic branching (worker, client, alerting).
  terminalReason String?

  // Provenance: the prompt contract this session was created under. Sessions
  // are never rewritten onto a new prompt mid-flight, so this always describes
  // the instructions that actually produced the transcript.
  // Contract the session was CREATED under. Defaults to the legacy value, not
  // the current one, so pre-existing sessions are backfilled truthfully.
  // createAgentSession always writes AGENT_PROMPT_VERSION explicitly.
  promptVersion String              @default("v1")

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  organization  Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  toolExecutions AgentToolExecution[]
  messages AgentMessage[]

  @@index([orgId, userId, createdAt])
  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@index([terminalReason])
}

model AgentToolExecution {
  id          String                   @id @default(cuid())
  sessionId   String
  toolCallId  String                   @unique

  toolName    String
  input        Json

  error       String?                  @db.Text
  status      AgentToolExecutionStatus @default(PENDING)

  // Confirmation audit trail. The proposal itself lives in `input`: the exact
  // arguments the model proposed are what gets persisted, shown to the user,
  // and later executed. Confirmation never re-generates them.
  confirmedAt DateTime?
  cancelledAt DateTime?

  // Approval expiry. `expiresAt` is written at proposal time (PENDING_CONFIRMATION)
  // as an explicit deadline, deliberately NOT derived from `updatedAt` -- every
  // unrelated touch would reset an `updatedAt`-derived deadline and let a
  // proposal live forever. `expiredAt` records when the timeout was actually
  // observed, so the two timestamps cannot be confused for each other.
  //
  // Assignment 37.9: for a `generateWorkflow` proposal that reaches
  // AWAITING_APPROVAL, `expiresAt` holds the REVIEW deadline instead. The two
  // meanings never coexist on one row -- a row is either PENDING_CONFIRMATION (a
  // tool awaiting confirmation) or COMPLETED with a proposal state -- so this is
  // one column with a mutually-exclusive meaning per lifecycle, not two.
  expiresAt DateTime?
  expiredAt DateTime?

  // Assignment 37.8 — durable outcome and proposal lifecycle.
  //
  // `input` is the immutable proposal; `result` is what executing it actually
  // produced. Persisting the result means a cold restart no longer has to parse
  // the transcript to learn how a step ended, and it makes the execution row a
  // self-contained record of the outcome.
  result Json?

  // Proposal identity and lifecycle. Null for every non-`generateWorkflow` tool.
  //
  // `proposalFingerprint` is the backend-owned content fingerprint of the exact
  // proposal revision (see `computeProposalCorrelationId`). It is a revision
  // label and an idempotency key, never a client-supplied value.
  // `proposalRevision` is the 1-based rank of this proposal among the session's
  // proposals in deterministic `(createdAt, id)` order, which is what makes
  // supersession total and reproducible across a restart.
  // `proposalState` is the proposal's own state machine, kept separate from
  // `status`; see `AgentProposalState`.
  proposalFingerprint String?
  proposalRevision    Int?
  proposalState       AgentProposalState?

  // The human's durable decision set. Written when the human answers a
  // clarification or records a per-step criticality decision, so the lifecycle
  // survives a restart without re-deriving the decision from the transcript.
  clarificationAnswer  Json?
  criticalityDecisions Json?

  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  session     AgentSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  materializedWorkflows Workflow[]     @relation("WorkflowSourceProposal")

  @@index([sessionId, createdAt])
  @@index([sessionId, status])
  // Backs the bounded maintenance scan for due approvals:
  // WHERE status = PENDING_CONFIRMATION AND expiresAt <= now() ORDER BY expiresAt
  @@index([status, expiresAt])
  // Backs the "is this session parked on a pending proposal?" predicate used by
  // recovery, so a deliberately-parked session is never re-driven or failed.
  @@index([sessionId, proposalState])
  // Backs the bounded maintenance scan for proposal reviews whose approval
  // window has closed:
  // WHERE proposalState = AWAITING_APPROVAL AND expiresAt <= now() ORDER BY expiresAt
  @@index([proposalState, expiresAt])
}

model AgentMessage {
  id         String @id @default(cuid())
  sessionId  String

  message    Json

  toolCallId String?
  step       Int

  createdAt  DateTime @default(now())

  session AgentSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)

  @@index([sessionId, createdAt])
}


enum AgentOutboxStatus {
  PENDING
  PUBLISHED
}

// Transactional outbox for critical agent events.
//
// The gap this closes: the agent writes domain state (a tool execution, a
// confirmation, a tool result) and then publishes to QStash. If the process
// dies between those two steps, the database says work is required but the
// event is gone forever, and the session hangs until the reaper notices.
//
// This table is written INSIDE the same transaction as the domain state, so
// the two either both commit or both roll back. A separate dispatcher then
// moves rows PENDING -> PUBLISHED. That yields durable intent + at-least-once
// delivery; exactly-once is explicitly not claimed, and duplicate delivery is
// made safe by consumer-side idempotency (EventLog messageId dedup and the
// CAS state machine).
//
// EventLog cannot serve this role: it is written by the *consumer* after the
// broker delivers, keyed on a broker-assigned messageId that does not exist
// at publish time, and it carries no retry scheduling fields.
//
// sessionId/executionId are plain strings, deliberately NOT foreign keys. An
// outbox row is a durable intent to deliver; if it cascaded away with the
// session it would be deleted before delivery, defeating the purpose.
model AgentOutboxEvent {
  id        String @id @default(cuid())

  // Deterministic, producer-side idempotency key, e.g.
  // "AGENT_TOOL_EXECUTION_REQUESTED:<executionId>". The unique constraint is
  // what makes a retried or duplicated write collapse into one logical record
  // instead of fanning out.
  idempotencyKey String @unique
  eventType      String
  // EventLog-compatible key so the published message can be deduped by the
  // consumer using the existing EventLog(messageId) protection.
  messageId      String @unique

  sessionId   String?
  executionId String?

  payload   Json

  status      AgentOutboxStatus @default(PENDING)
  attempts    Int               @default(0)
  // Backoff gate. Failed rows are pushed forward here rather than retried
  // immediately, so a poison event cannot spin the dispatcher.
  availableAt DateTime          @default(now())

  createdAt   DateTime          @default(now())
  publishedAt DateTime?
  lastError   String?           @db.Text

  @@index([status, availableAt])
  @@index([sessionId])
  @@index([executionId])
}


model Invitation {
  id         String            @id @default(cuid())
  email      String
  token      String            @unique
  role       Role              // Reuse your existing Role enum
  status     InvitationStatus  @default(PENDING)
  expiresAt  DateTime

  orgId        String
  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([orgId])
  @@index([email])
}


model Task {
  id          String        @id @default(cuid())
  title       String

  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)

  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description String? 

  assigneeId  String?
 assignee     User?         @relation("UserTasks", fields: [assigneeId], references: [id])


  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  attachments Attachment[]
comments      Comment[]



  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}


