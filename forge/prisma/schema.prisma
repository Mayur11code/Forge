datasource db { 
  provider = "postgresql" 
  } 
generator client { 
  provider = "prisma-client-js" 
  }

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}


enum EventStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WorkflowExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  ROLLING_BACK
  ROLLED_BACK
  REQUIRES_INTERVENTION
}

enum StepExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
  RETRYING
  SKIPPED
  COMPENSATING
  COMPENSATED
  COMPENSATION_FAILED
}

enum LogLevel {
  INFO
  WARN
  ERROR
  FATAL
}

enum AgentSessionStatus {
  RUNNING
  WAITING_CONFIRMATION
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentToolExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AgentMessageRole {
    USER
    ASSISTANT
    TOOL
    SYSTEM
}

model AgentSession {
  id            String             @id @default(cuid())
  orgId         String
  userId        String

  status        AgentSessionStatus @default(RUNNING)
  currentStep   Int                @default(0)


  finalResponse String?            @db.Text
  errorMessage  String?            @db.Text

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  organization  Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  toolExecutions AgentToolExecution[]
  messages AgentMessage[]

  @@index([orgId, userId, createdAt])
  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model AgentToolExecution {
  id          String                   @id @default(cuid())
  sessionId   String
  toolCallId  String                   @unique

  toolName    String
  input        Json

  error       String?                  @db.Text
  status      AgentToolExecutionStatus @default(PENDING)

  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  session     AgentSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([sessionId, status])
}

model AgentMessage {
  id         String @id @default(cuid())
  sessionId  String

  message    Json

  toolCallId String?
  step       Int

  createdAt  DateTime @default(now())

  session AgentSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)

  @@index([sessionId, createdAt])
}


model Invitation {
  id         String            @id @default(cuid())
  email      String
  token      String            @unique
  role       Role              // Reuse your existing Role enum
  status     InvitationStatus  @default(PENDING)
  expiresAt  DateTime

  orgId        String
  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([orgId])
  @@index([email])
}


model Task {
  id          String        @id @default(cuid())
  title       String

  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)

  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description String? 

  assigneeId  String?
 assignee     User?         @relation("UserTasks", fields: [assigneeId], references: [id])


  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  attachments Attachment[]
comments      Comment[]



  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}


model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  password    String?
  image       String?

  memberships Membership[]
  tasks       Task[]       @relation("UserTasks")
  comments    Comment[]
  agentSessions AgentSession[]

}

model Project {
  id            String        @id @default(cuid())
  name          String
  description   String?
  orgId         String
  createdAt     DateTime      @default(now())

  tasks         Task[]

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([name, orgId])
  @@index([orgId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  // Relations
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}



model Organization { 
  id          String      @id @default(uuid()) 
  slug        String      @unique 
  name        String 
  memberships Membership[] 
  storageUsed   BigInt   @default(0)
  storageLimit  BigInt   @default(1073741824) // 1GB default
  logo         String?
  projects    Project[]
  invitations Invitation[]
  razorpayCustomerId      String?   @unique
  razorpaySubscriptionId  String?   @unique
  planId                  String?
  subscriptionStatus      String?
  currentPeriodEnd        DateTime?
  workflows   Workflow[]
  agentSessions AgentSession[]
}

model Membership {
  id      String    @id @default(uuid()) 
  role    Role      @default(MEMBER) 
  userId  String    
  orgId   String 
  createdAt DateTime @default(now()) 
  user    User        @relation(fields: [userId], references: [id]) 
  organization Organization @relation(fields: [orgId], references: [id])    
  
  
  @@unique([userId, orgId]) // Fixed the syntax error on line 33
  
   }


model Attachment {
  id        String   @id @default(cuid())
  fileKey   String?   
  url       String
  name      String
  size      Int

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model EventLog {
  id          String      @id @default(cuid())

  messageId   String      @unique 
  eventName   String      
  payload     Json?       

  status      EventStatus @default(PENDING)
  error       String?     @db.Text

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventName String
  orgId     String?
  createdAt DateTime @default(now())

  @@index([eventName])
  @@index([orgId])
}

model RazorpayEvent {
  id String @id
  createdAt DateTime @default(now())
} 

model Workflow {
  id          String   @id @default(cuid()) // or uuid(), both are fine
  name        String
  description String?
  isActive    Boolean  @default(false)
  

  uiNodes     Json     @default("[]") 
  uiEdges     Json     @default("[]")
  

  definition  Json     @default("{}")
  

  orgId       String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  eventId     String? // Nullable initially until the user connects a trigger

  // event    Event?  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  
  runs        WorkflowRun[] // Excellent addition for observability

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
  @@index([eventId])
}


model WorkflowRun {
  id          String                  @id @default(cuid())
  workflowId  String
  status      WorkflowExecutionStatus @default(PENDING)

  context     Json                    @default("{}") 

  startedAt   DateTime                @default(now())
  completedAt DateTime?

 
  workflow    Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepRuns    StepRun[]
  auditLogs ExecutionAuditLog[]

  @@index([workflowId])
  @@index([status])
}


model StepRun {
  id          String              @id @default(cuid())
  runId       String
  
  // The ID of the node from your React Flow canvas (e.g., "action_1775844011153")
  stepId      String              

  status      StepExecutionStatus @default(PENDING)
  attempts    Int                 @default(0) // Tracks retries for exponential backoff
  compensationAttempts  Int @default(0) 

  // Execution Payloads
  inputs      Json?             
  outputs     Json?               
  error       String?             @db.Text // Stack traces or API failure reasons

  startedAt   DateTime?
  completedAt DateTime?

  // Relations
  run         WorkflowRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  auditLogs  ExecutionAuditLog[]

  // Critical Indexes: The Engine Evaluator will constantly query these to calculate DAG readiness
  @@index([runId])
  @@index([runId, status])
  @@index([stepId])

  @@unique([runId, stepId])
}


model ExecutionAuditLog {
  id          String    @id @default(cuid())
  
  // What execution does this belong to?
  runId       String
  stepId      String
  
  logLevel    LogLevel  @default(INFO)
  

  eventType   String    
  

  message     String    @db.Text
  
 
  payload     Json?     
  

  latencyMs   Int?      
  
  createdAt   DateTime  @default(now())

 
  run         WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  step        StepRun     @relation(fields: [stepId], references: [id], onDelete: Cascade)

  // High-performance indexing for debugging dashboards
  @@index([runId])
  @@index([stepId])
  @@index([eventType])
  @@index([createdAt])
}


