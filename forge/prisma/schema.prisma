  userId  String    
  orgId   String 
  createdAt DateTime @default(now()) 
  user    User        @relation(fields: [userId], references: [id]) 
  organization Organization @relation(fields: [orgId], references: [id])    
  
  
  @@unique([userId, orgId]) // Fixed the syntax error on line 33
  
   }


model Attachment {
  id        String   @id @default(cuid())
  fileKey   String?   
  url       String
  name      String
  size      Int

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model EventLog {
  id          String      @id @default(cuid())

  messageId   String      @unique 
  eventName   String      
  payload     Json?       

  status      EventStatus @default(PENDING)
  error       String?     @db.Text

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventName String
  orgId     String?
  createdAt DateTime @default(now())

  @@index([eventName])
  @@index([orgId])
}

model RazorpayEvent {
  id String @id
  createdAt DateTime @default(now())
} 

model Workflow {
  id          String   @id @default(cuid()) // or uuid(), both are fine
  name        String
  description String?
  isActive    Boolean  @default(false)
  

  uiNodes     Json     @default("[]") 
  uiEdges     Json     @default("[]")
  

  definition  Json     @default("{}")
  

  orgId       String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  eventId     String? // Nullable initially until the user connects a trigger

  // event    Event?  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  
  runs        WorkflowRun[] // Excellent addition for observability

  // Assignment 37.8 — provenance back-link to the proposal this workflow was
  // materialized from (written by 37.11). `@unique` makes materialization
  // idempotent: a retried materialization cannot create a second workflow for
  // the same proposal. `onDelete: SetNull` means deleting the source execution
  // (e.g. its session cascades) does NOT delete a workflow the user already has;
  // Postgres permits many NULLs under a unique index, so hand-authored workflows
  // are unaffected.
  sourceProposalId String?  @unique
  sourceProposal   AgentToolExecution? @relation("WorkflowSourceProposal", fields: [sourceProposalId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
  @@index([eventId])
}


model WorkflowRun {
  id          String                  @id @default(cuid())
  workflowId  String
  status      WorkflowExecutionStatus @default(PENDING)

  context     Json                    @default("{}") 

  // Optimistic-concurrency token for `context`.
  //
  // Parallel branches of a DAG finish at the same time and each one rewrites
  // the whole `context` blob, so without a version to compare against, the
  // second write silently discards the first branch's output. The evaluator's
  // lock does not cover this: step completion happens in the step worker, not
  // inside the evaluator. See `src/lib/workflow/execution/state.ts`.
  contextVersion Int                   @default(0)

  // Last time this run made observable progress: a step dispatched, a step
  // finished, a rollback advanced, or a re-entry was evaluated.
  //
  // This is what makes a stuck run detectable at all. `startedAt` alone cannot
  // distinguish "legitimately long-running" from "crashed three hours ago" -
  // both are simply an old `startedAt` on a non-terminal row. Bumped on the
  // paths that change the run, and read by the stale-run sweeper in
  // `src/lib/workflow/maintenance.ts`.
  lastAdvancedAt DateTime?

  startedAt   DateTime                @default(now())
  completedAt DateTime?

 
  workflow    Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepRuns    StepRun[]
  auditLogs ExecutionAuditLog[]

  @@index([workflowId])
  @@index([status])
}


model StepRun {
  id          String              @id @default(cuid())
  runId       String
  
  // The ID of the node from your React Flow canvas (e.g., "action_1775844011153")
  stepId      String              

  status      StepExecutionStatus @default(PENDING)
  attempts    Int                 @default(0) // Tracks retries for exponential backoff
  compensationAttempts  Int @default(0) 

  // Execution Payloads
  inputs      Json?             
  outputs     Json?               
  error       String?             @db.Text // Stack traces or API failure reasons

  startedAt   DateTime?
  completedAt DateTime?

  // Relations
  run         WorkflowRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  auditLogs  ExecutionAuditLog[]

  // Critical Indexes: The Engine Evaluator will constantly query these to calculate DAG readiness
  @@index([runId])
  @@index([runId, status])
  @@index([stepId])

  @@unique([runId, stepId])
}


model ExecutionAuditLog {
  id          String    @id @default(cuid())
  
  // What execution does this belong to?
  runId       String
  stepId      String
  
  logLevel    LogLevel  @default(INFO)
  

  eventType   String    
  

  message     String    @db.Text
  
 
  payload     Json?     
  

  latencyMs   Int?      
  
  createdAt   DateTime  @default(now())

 
  run         WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  step        StepRun     @relation(fields: [stepId], references: [id], onDelete: Cascade)

  // High-performance indexing for debugging dashboards
  @@index([runId])
  @@index([stepId])
  @@index([eventType])
  @@index([createdAt])
}


