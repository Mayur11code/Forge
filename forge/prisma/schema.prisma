datasource db { 
  provider = "postgresql" 
  } 
generator client { 
  provider = "prisma-client-js" 
  }

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}


enum EventStatus {
  PENDING
  SUCCESS
  FAILED
}

model Invitation {
  id         String            @id @default(cuid())
  email      String
  token      String            @unique
  role       Role              // Reuse your existing Role enum
  status     InvitationStatus  @default(PENDING)
  expiresAt  DateTime

  orgId        String
  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([orgId])
  @@index([email])
}


model Task {
  id          String        @id @default(cuid())
  title       String

  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)

  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description String? 

  assigneeId  String?
 assignee     User?         @relation("UserTasks", fields: [assigneeId], references: [id])


  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  attachments Attachment[]
comments      Comment[]



  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}


model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  password    String?
  image       String?

  memberships Membership[]
  tasks       Task[]       @relation("UserTasks")
  comments    Comment[]

}

model Project {
  id            String        @id @default(cuid())
  name          String
  description   String?
  orgId         String
  createdAt     DateTime      @default(now())

  tasks         Task[]

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([name, orgId])
  @@index([orgId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  // Relations
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}



model Organization { 
  id          String      @id @default(uuid()) 
  slug        String      @unique 
  name        String 
  memberships Membership[] 
  storageUsed   BigInt   @default(0)
  storageLimit  BigInt   @default(1073741824) // 1GB default
  logo         String?
  projects    Project[]
  invitations Invitation[]
  razorpayCustomerId      String?   @unique
  razorpaySubscriptionId  String?   @unique
  planId                  String?
  subscriptionStatus      String?
  currentPeriodEnd        DateTime?
  workflows   Workflow[]
}

model Membership {
  id      String    @id @default(uuid()) 
  role    Role      @default(MEMBER) 
  userId  String    
  orgId   String 
  createdAt DateTime @default(now()) 
  user    User        @relation(fields: [userId], references: [id]) 
  organization Organization @relation(fields: [orgId], references: [id])    
  
  
  @@unique([userId, orgId]) // Fixed the syntax error on line 33
  
   }


model Attachment {
  id        String   @id @default(cuid())
  fileKey   String?   // 👈 NEW (required for signed downloads)
  url       String
  name      String
  size      Int

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model EventLog {
  id          String      @id @default(cuid())

  messageId   String      @unique 
  eventName   String      
  payload     Json?       

  status      EventStatus @default(PENDING)
  error       String?     @db.Text

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventName String
  orgId     String?
  createdAt DateTime @default(now())

  @@index([eventName])
  @@index([orgId])
}

model RazorpayEvent {
  id String @id
  createdAt DateTime @default(now())
} 

model Workflow {
  id          String   @id @default(cuid()) // or uuid(), both are fine
  name        String
  description String?
  isActive    Boolean  @default(false)
  
  // ------------------------------------------------------
  // 1. THE VISUAL STATE (For React Flow UI - Assignment 25)
  // Stores { id, type, position: {x,y}, data }
  // ------------------------------------------------------
  uiNodes     Json     @default("[]") 
  uiEdges     Json     @default("[]")
  
  // ------------------------------------------------------
  // 2. THE EXECUTION BLUEPRINT (For DAG Engine - Assignment 26)
  // An Adjacency Dictionary stripped of UI bloat.
  // e.g. { "trigger_1": ["action_email"], "action_email": ["action_slack"] }
  // ------------------------------------------------------
  definition  Json     @default("{}")
  
  // ------------------------------------------------------
  // 3. MULTI-TENANCY & EVENT TRIGGERS
  // ------------------------------------------------------
  orgId       String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  eventId     String? // Nullable initially until the user connects a trigger
  // Assuming you have an Event model:
  // event    Event?  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  
  runs        WorkflowRun[] // Excellent addition for observability

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
  @@index([eventId])
}

// Don't forget the WorkflowRun model you referenced!
model WorkflowRun {
  id          String   @id @default(cuid())
  workflowId  String
  status      String   // e.g., "PENDING", "SUCCESS", "FAILED"
  startedAt   DateTime @default(now())
  completedAt DateTime?
  logs        Json     @default("[]") // For stack traces/DLQ tracking
  
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  @@index([workflowId])
}