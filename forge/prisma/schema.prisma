datasource db {
  provider = "postgresql"

}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String?      // Added to support the "name" field in your seed script
  password    String?
  memberships Membership[]
}

model Organization {
  id          String       @id @default(uuid())
  slug        String       @unique
  name        String
  memberships Membership[]
  projects    Project[]

}

model Membership {
  id             String       @id @default(uuid())
  role           Role         @default(MEMBER)
  userId         String
  orgId          String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [orgId], references: [id])

  @@unique([userId, orgId]) // Fixed the syntax error on line 33
}

model Project {
  id          String       @id @default(uuid())
  name        String
  description String?
  orgId       String
  createdAt   DateTime     @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade )
  
}
