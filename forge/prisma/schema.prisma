  logo         String?
  projects    Project[]
  invitations Invitation[]
  razorpayCustomerId      String?   @unique
  razorpaySubscriptionId  String?   @unique
  planId                  String?
  subscriptionStatus      String?
  currentPeriodEnd        DateTime?
  workflows   Workflow[]
  agentSessions AgentSession[]
}

