datasource db { 
  provider = "postgresql" 
  } 
generator client { 
  provider = "prisma-client-js" 
  }

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}


enum EventStatus {
  PENDING
  SUCCESS
  FAILED
}

model Invitation {
  id         String            @id @default(cuid())
  email      String
  token      String            @unique
  role       Role              // Reuse your existing Role enum
  status     InvitationStatus  @default(PENDING)
  expiresAt  DateTime

  orgId        String
  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([orgId])
  @@index([email])
}


model Task {
  id          String        @id @default(cuid())
  title       String

  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)

  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description String? 

  assigneeId  String?
 assignee     User?         @relation("UserTasks", fields: [assigneeId], references: [id])


  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  attachments Attachment[]
comments      Comment[]



  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}


model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  password    String?
  image       String?

  memberships Membership[]
  tasks       Task[]       @relation("UserTasks")
  comments    Comment[]

}

model Project {
  id            String        @id @default(cuid())
  name          String
  description   String?
  orgId         String
  createdAt     DateTime      @default(now())

  tasks         Task[]

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([name, orgId])
  @@index([orgId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  // Relations
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}



model Organization { 
  id          String      @id @default(uuid()) 
  slug        String      @unique 
  name        String 
  memberships Membership[] 
  storageUsed   BigInt   @default(0)
  storageLimit  BigInt   @default(1073741824) // 1GB default
  logo         String?
  projects    Project[]
  invitations Invitation[]
}

model Membership {
  id      String    @id @default(uuid()) 
  role    Role      @default(MEMBER) 
  userId  String    
  orgId   String 
  createdAt DateTime @default(now()) 
  user    User        @relation(fields: [userId], references: [id]) 
  organization Organization @relation(fields: [orgId], references: [id])    
  
  
  @@unique([userId, orgId]) // Fixed the syntax error on line 33
  
   }


model Attachment {
  id        String   @id @default(cuid())
  fileKey   String?   // 👈 NEW (required for signed downloads)
  url       String
  name      String
  size      Int

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model EventLog {
  id          String      @id @default(cuid())

  messageId   String      @unique 
  eventName   String      
  payload     Json?       

  status      EventStatus @default(PENDING)
  error       String?     @db.Text

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}