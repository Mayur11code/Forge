# ─────────────────────────────────────────────────────────────────────────────
# engineered forge — environment template
#
# Copy to `.env` and fill in.   cp .env.example .env
#
# `.env` is gitignored (forge/.gitignore:34). Never commit real secrets.
# Every variable below is read by the code — the file:line citation says which
# module consumes it, so you can tell what a missing value actually breaks.
#
# Only DATABASE_URL and AUTH_SECRET are needed to boot. Everything else is
# feature-scoped: the app will start without it and fail when you use the
# feature. Sections marked [core] gate the parts most people try first.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Read by src/lib/prisma/db.ts:5 (pool + PrismaPg driver adapter) and
# prisma/seed.ts:6.
# The app builds a `pg` Pool behind @prisma/adapter-pg. See the serverless
# note in src/lib/prisma/db.ts before deploying to a connection-limited host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/forge?schema=public"


# ── Auth ────────────────────────────────────────────────────────────────────
# Auth.js (NextAuth v5) signing secret. Generate with: openssl rand -base64 32
# Read by src/lib/auth/auth.ts:18 and src/lib/auth/auth.config.ts:5.
AUTH_SECRET=""

# Google OAuth credentials. Read by src/lib/auth/auth.config.ts:13-14.
#
# ⚠ NOT YET FUNCTIONAL. The PrismaAdapter is mounted but prisma/schema.prisma
#   has no Account / VerificationToken model, so a Google sign-in cannot
#   persist a user. Tracked in docs/architecture/agent/roadmap.md.
#   Credentials + email/password login both work today.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Public origin. Used to build invite links
# (src/app/actions/Invitations/createInvitation.ts:62) and agent callback URLs
# (src/lib/ai/agent/constants.ts:146). Keep APP_URL and NEXT_PUBLIC_APP_URL in
# sync; set both.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"


# ── AI ──────────────────────────────────────────────────────────────────────
# Google Gemini. The ONLY model provider wired up — src/lib/ai/provider.ts:7
# reads GEMINI_API_KEY and nothing else. Used for chat, triage, the audit
# stream, embeddings (gemini-embedding-001 @ 768 dims) and the agent runtime.
#
# There is no OpenAI usage in this codebase. If you are porting an old .env,
# OPENAI_API_KEY can be deleted.
GEMINI_API_KEY=""

# How long an agent's pending write-tool approval stays valid.
# Read by src/lib/ai/agent/constants.ts:94. Unparseable / non-positive values
# fall back to the default rather than throwing.
AGENT_APPROVAL_TIMEOUT_MS="600000"

# Optional: override the QStash topic the agent loop publishes to. The default
# lives in code; you only need this if you are mirroring traffic.
AGENT_LOOP_REQUESTED_TOPIC=""


# ── Async: QStash ───────────────────────────────────────────────────────────
# Upstash QStash. src/lib/events/queue.ts:22 and :26 THROW if QSTASH_URL or
# QSTASH_TOKEN are absent, so the event bus cannot initialise without both.
#
# This is the backbone of task-created fan-out and workflow re-entry
# (ADVANCE_WORKFLOW). Without it the product still runs, but asynchronously.
QSTASH_URL=""
QSTASH_TOKEN=""

# Receiver signing keys. Consumed by @upstash/qstash's Receiver to verify that
# an inbound request really came from QStash. Rotate at QStash; put the new
# value in NEXT_SIGNING_KEY and promote it to CURRENT_SIGNING_KEY.
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""


# ── Redis: Upstash ──────────────────────────────────────────────────────────
# Read by src/lib/redis/client.ts:6-7.
# Backs rate limiting, token-checked locks with heartbeat, QStash dedup/state,
# per-workflow-run locks, agent session locks, and the semantic cache.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# ── Realtime: Pusher ────────────────────────────────────────────────────────
# Read by src/lib/pusher/pusher-server.ts:9-12 (server) and
# src/lib/pusher/pusher-client.ts:7 (browser — the NEXT_PUBLIC_ pair is
# shipped to the client, so the secret must never be used as the public key).
# Drives the live run graph and agent status channels.
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""


# ── Vector: Pinecone ────────────────────────────────────────────────────────
# Read by src/lib/vector/client.ts:9-10, which picks the pair based on whether
# VERCEL_ENV / NODE_ENV is production. DEV is used locally, PROD in production.
# Each organization gets its own namespace inside the index.
PINECONE_API_KEY_DEV=""
PINECONE_INDEX_DEV=""
PINECONE_API_KEY_PROD=""
PINECONE_INDEX_PROD=""


# ── Email: Resend ───────────────────────────────────────────────────────────
# Read by src/lib/emails/email.ts:3.
RESEND_API_KEY=""


# ── File storage: UploadThing ───────────────────────────────────────────────
# Read by the UploadThing SDK. Attachments are quota-checked against
# Organization.storageUsed against storageLimit (1 GB default) and validated by
# magic bytes in src/lib/security/magic-bytes.ts.
UPLOADTHING_TOKEN=""


# ── Billing: Razorpay ───────────────────────────────────────────────────────
# Read by src/app/api/razerpay/create-order/route.ts:6-22.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_PLAN_ID=""

# HMAC secret for the webhook signature check in
# src/app/api/webhooks/razorpay/route.ts:14.
RAZORPAY_WEBHOOK_SECRET=""


# ── Development only ────────────────────────────────────────────────────────
# Set to "true" to let the local worker accept UNSIGNED messages.
# src/lib/events/worker.ts:27 compares against the exact string "true" — any
# other value is falsy, and the presence of the variable is not enough.
# Never set this in production: it disables inbound message authentication.
ALLOW_UNSIGNED_LOCAL_WORKER="false"