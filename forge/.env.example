# ─────────────────────────────────────────────────────────────────────────────
# engineered forge — environment configuration template
#
# Copy to `.env` and fill in:   cp .env.example .env
#
# SECURITY & COMPLIANCE:
# - `.env` is gitignored. NEVER commit real secrets or credentials.
# - Production Hardening H1 enforces a strict compile-time and runtime
#   server-only airgap (`server-only`).
# - Variables prefixed with `NEXT_PUBLIC_` are exposed directly to browser client
#   bundles. Never prefix private credentials, database URLs, or provider keys
#   with `NEXT_PUBLIC_`.
# - Core Boot vs Feature-Scoped:
#   Only DATABASE_URL and AUTH_SECRET are strictly required to boot the server.
#   Subsystems (AI, QStash, Redis, Pusher, Vector, Email, Billing) validate
#   their required variables on-demand when their respective functions run.
#
# ENVIRONMENT SEGREGATION:
# - Local Development: uses DEV credentials (e.g. PINECONE_*_DEV) and allows
#   ALLOW_UNSIGNED_LOCAL_WORKER="true" for isolated testing without QStash webhook tunnels.
# - Vercel Preview Deployments: inherits development vector indices, isolates test state,
#   and enforces signature checks on all public worker routes.
# - Production Deployments: requires PROD vector credentials (PINECONE_*_PROD),
#   enforces strict QStash signing keys, and categorically ignores unsigned worker bypasses.
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. Core Server Runtime & Database [SERVER-ONLY SECRET] ───────────────────
# PostgreSQL connection string. Read by src/lib/prisma/db.ts and src/lib/env/server.ts.
# Must begin with postgresql:// or postgres://.
# In production on serverless (e.g. Vercel), use connection pooler endpoints (Neon/PgBouncer).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/forge?schema=public"

# Auth.js (NextAuth v5) signing and encryption secret. [SERVER-ONLY SECRET]
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-character-random-auth-secret-here"

# Google OAuth credentials. [SERVER-ONLY]
# Optional / conditional for OAuth sign-in.
AUTH_GOOGLE_ID="google-oauth-client-id"
AUTH_GOOGLE_SECRET="google-oauth-client-secret"

# Internal Server Application URL. [SERVER-ONLY RUNTIME CONFIG]
# Used for server-side link generation and agent callback targets.
APP_URL="http://localhost:3000"


# ── 2. Public Client Configuration [PUBLIC BROWSER-VISIBLE] ─────────────────
# Public application origin exposed to client components.
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ── 3. Google Gemini AI & Agent Runtime [SERVER-ONLY SECRET] ────────────────
# Google Gemini API key. Read by src/lib/ai/provider.ts and embedding worker.
# Used for chat, triage, audit stream, semantic embeddings, and the agent runtime.
GEMINI_API_KEY="AIzaSy-your-gemini-api-key-here"

# Zero-downtime rotation fallback key (optional). If set and the primary key encounters
# an authentication error (e.g. during rotation window), Forge automatically falls back
# to this secondary key without interrupting in-flight requests.
GEMINI_API_KEY_FALLBACK=""

# Pending write-tool approval timeout in milliseconds (default: 600000 = 10 min).
AGENT_APPROVAL_TIMEOUT_MS="600000"

# Optional: override the QStash topic the agent loop publishes to (default: "events").
AGENT_LOOP_REQUESTED_TOPIC=""

# Legacy/unused fallback key. OpenAI is not used in Forge. Safe to leave empty.
OPENAI_API_KEY=""


# ── 4. Asynchronous Queue: Upstash QStash [SERVER-ONLY SECRET] ──────────────
# REST endpoint and token for QStash event bus fan-out and workflow execution.
# Upstash is multi-region; baseUrl must match your region (e.g. qstash-us-east-1.upstash.io).
QSTASH_URL="https://qstash.upstash.io"
QSTASH_TOKEN="qstash-rest-token-here"

# Inbound webhook signature verification keys.
# Required in production. Rotate by setting NEXT_SIGNING_KEY before promoting to CURRENT.
QSTASH_CURRENT_SIGNING_KEY="sig-key-current"
QSTASH_NEXT_SIGNING_KEY="sig-key-next"


# ── 5. Distributed Cache & Locks: Upstash Redis [SERVER-ONLY SECRET] ─────────
# Read by src/lib/redis/client.ts. Backs distributed rate-limiting, CAS locks,
# workflow step locks, and semantic search cache.
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="upstash-redis-rest-token-here"


# ── 6. Realtime Messaging: Pusher ────────────────────────────────────────────
# Server-only credentials for emitting live UI updates. [SERVER-ONLY SECRET]
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_SECRET="your-pusher-app-secret"

# Public configuration for browser WebSocket subscriptions. [PUBLIC BROWSER-VISIBLE]
# Shipped to the browser client. Never place PUSHER_SECRET here.
NEXT_PUBLIC_PUSHER_KEY="your-pusher-public-key"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"


# ── 7. Vector Database: Pinecone [ENVIRONMENT-SEGREGATED] ───────────────────
# Segregated into DEV and PROD pairs. The client automatically picks the pair
# based on NODE_ENV / VERCEL_ENV. Each organization has its own isolated namespace.
#
# Development & Preview deployments:
PINECONE_API_KEY_DEV="pinecone-dev-api-key"
PINECONE_INDEX_DEV="forge-dev"
# Optional fallback key for zero-downtime rotation in dev/preview:
PINECONE_API_KEY_DEV_FALLBACK=""

# Production deployments:
PINECONE_API_KEY_PROD="pinecone-prod-api-key"
PINECONE_INDEX_PROD="forge-prod"
# Optional fallback key for zero-downtime rotation in production:
PINECONE_API_KEY_PROD_FALLBACK=""


# ── 8. Transactional Email: Resend [SERVER-ONLY SECRET] ─────────────────────
# Read by src/lib/emails/email.ts for member invitations and system alerts.
RESEND_API_KEY="re_your_resend_api_key_here"


# ── 9. File Storage: UploadThing [SERVER-ONLY SECRET] ───────────────────────
# Read by UploadThing SDK for attachment uploads and quota verification.
UPLOADTHING_TOKEN="uploadthing-api-token-here"


# ── 10. Billing: Razorpay [SERVER-ONLY SECRET] ──────────────────────────────
# Read by billing subscription and webhook endpoints.
RAZORPAY_KEY_ID="rzp_test_key_id"
RAZORPAY_KEY_SECRET="razorpay_key_secret"
RAZORPAY_PLAN_ID="plan_test_id"

# HMAC secret for inbound webhook authenticity verification.
RAZORPAY_WEBHOOK_SECRET="razorpay_webhook_secret"


# ── 11. Development Only Guards [STRICTLY NON-PRODUCTION] ────────────────────
# Set to "true" ONLY for local test suites or testing workers without QStash signatures.
# Categorically refused and ignored when NODE_ENV="production".
ALLOW_UNSIGNED_LOCAL_WORKER="false"
